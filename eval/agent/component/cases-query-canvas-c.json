  "cases": [
    {
      "id": "qc-013",
      "split": "held_in",
      "family": "tushare_query_canvas",
      "question": "比较美的集团和格力电器 2020 到 2024 年营收",
      "toolset": "component_v1",
      "gold": {
        "call_policy": "must_call",
        "expected": [
          {
            "name": "query_data",
            "required": true,
            "args": {
              "metric": { "eq": "revenue" },
              "entities": {
                "covers": [
                  { "any": ["美的集团", "美的", "000333"] },
                  { "any": ["格力电器", "格力", "000651"] }
                ]
              },
              "start": { "eq": "2020" },
              "end": { "eq": "2024" }
            }
          }
        ],
        "optional_before": ["search_instruments"],
        "forbidden": ["get_instrument_financials", "create_widget", "create_canvas", "web_search"],
        "max_calls": 3,
        "tushare_via": "query_data.financials",
        "judge_notes": "两家家电营收走 query_data。"
      }
    },
