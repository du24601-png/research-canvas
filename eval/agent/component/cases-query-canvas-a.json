{
  "file": "cases-query-canvas-a.json",
  "family": "tushare_query_canvas",
  "cases": [
    {
      "id": "qc-001",
      "split": "held_in",
      "family": "tushare_query_canvas",
      "question": "比较赛轮轮胎、玲珑轮胎、森麒麟 2021–2025 年毛利率",
      "toolset": "component_v1",
      "gold": {
        "call_policy": "must_call",
        "expected": [
          {
            "name": "query_data",
            "required": true,
            "args": {
              "metric": { "eq": "gross_margin" },
              "entities": {
                "covers": [
                  { "any": ["赛轮轮胎", "赛轮", "601058"] },
                  { "any": ["玲珑轮胎", "玲珑", "601966"] },
                  { "any": ["森麒麟", "002984"] }
                ]
              },
              "start": { "eq": "2021" },
              "end": { "in": ["2025", "2026"] },
              "confirmed": { "absent_or_false": true }
            }
          }
        ],
        "optional_before": [
          "search_instruments"
        ],
        "forbidden": [
          "get_instrument_financials",
          "create_widget",
          "update_widget",
          "create_canvas",
          "web_search"
        ],
        "max_calls": 4,
        "tushare_via": "query_data.financials",
        "judge_notes": "三家比较走 query_data，禁止用单只财务摘要或网页搜索代替。"
      }
    },
