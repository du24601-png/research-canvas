      "id": "qc-007",
      "split": "held_in",
      "family": "tushare_query_canvas",
      "question": "茅台最近几年净利润走势",
      "toolset": "component_v1",
      "gold": {
        "call_policy": "must_call",
        "expected": [
          {
            "name": "query_data",
            "required": true,
            "args": {
              "metric": { "eq": "net_income" },
              "entities": {
                "covers": [
                  { "any": ["贵州茅台", "茅台", "600519"] }
                ]
              }
            }
          }
        ],
        "optional_before": [
          "search_instruments"
        ],
        "forbidden": [
          "get_instrument_financials",
          "create_widget",
          "create_canvas",
          "web_search"
        ],
        "max_calls": 3,
        "tushare_via": "query_data.financials",
        "judge_notes": "净利润 = net_income，禁止用 net_margin。"
      }
    },
